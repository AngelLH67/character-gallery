<#import "layout.ftlh" as layout>

<@layout.page title="About">

    <main class="about-page">
        <h1>About This Gallery</h1>
        <p>Learn more about the Dragon Ball Character Gallery</p>

        <img class="about-image" src="/images/about.png" alt="About This Website">

        <h2>Welcome to the Dragon Ball Character Gallery</h2>
        <p>
            The Dragon Ball Character Gallery showcases characters from the beginning
            of Dragon Ball Z to Dragon Ball Super.
        </p>

        <h2>Why Dragon Ball?</h2>
        <p>
            Dragon Ball is one of the most recognizable anime series of all time and
            has many fans around the world. The series includes a wide variety of
            characters including heroes, villains, and anti-heroes all ranging from
            different races and backgrounds.
        </p>

        <p>
            This website is aimed to create a simple character gallery where visitors
            can learn basic information about some popular Dragon Ball characters.
        </p>
    </main>


</@layout.page>