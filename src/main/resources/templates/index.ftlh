<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dragon Ball Character Gallery</title>
    <link rel="stylesheet" href="styles.css">

</head>

<body>

    <nav>
        <h2>Dragon Ball Gallery</h2>

        <div class="nav-links">
            <a href="index.html">Home</a>
            <a href="details.html">Details</a>
            <a href="about.html">About</a>
            <a href="new-character-form.html">Add a Character</a>
        </div>
    </nav>

    <header>
        <h1>Dragon Ball Character Gallery</h1>
        <p>Explore some of the most iconic characters from the Dragon Ball series!</p>

        <input type="text" placeholder="Search characters...">
    </header>

    <main class="gallery">
        <div class="character-card">
            <img src="images/goku.png" alt="Goku">
            <h2>Goku</h2>
            <p><strong>Universe:</strong> Universe 7</p>
            <p><strong>Role:</strong> Hero</p>
            <p> A low class saiyan warrior who was raised on earth.</p>
            <a class="button" href="details.html">View Details</a>
        </div>

        <div class="character-card">
            <img src="images/vegeta.png" alt="Vegeta">
            <h2>Vegeta</h2>
            <p><strong>Universe:</strong> Universe 7</p>
            <p><strong>Role:</strong> Anti-Hero</p>
            <p>The prideful prince of the Saiyan race and is the rival of Goku.</p>
            <a class="button" href="details.html">View Details</a>
        </div>

        <div class="character-card">
            <img src="images/gohan.png" alt="Gohan">
            <h2>Gohan</h2>
            <p><strong>Universe:</strong> Universe 7</p>
            <p><strong>Role:</strong> Hero</p>
            <p>The eldest son of Goku, known for his potential and kind heart.</p>
            <a class="button" href="details.html">View Details</a>
        </div>

        <div class="character-card">
            <img src="images/piccolo.png" alt="Piccolo">
            <h2>Piccolo</h2>
            <p><strong>Universe:</strong> Universe 7</p>
            <p><strong>Role:</strong> Hero</p>
            <p>A Namekian warrior and mentor to Gohan, known for his intelligence and strategy.</p>
            <a class="button" href="details.html">View Details</a>
        </div>

        <div class="character-card">
            <img src="images/frieza.png" alt="Frieza">
            <h2>Frieza</h2>
            <p><strong>Universe:</strong> Universe 7</p>
            <p><strong>Role:</strong> Villain</p>
            <p>A sociopathic galactic tyrant who rules over a vast empire.</p>
            <a class="button" href="details.html">View Details</a>
        </div>

    </main>

    <footer>
        <p> &copy; 2026 Dragon Ball Character Gallery</p>
    </footer>


</body>

</html>